# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/recoverai
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Server ---
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# --- Grok (xAI) API — used by Diagnosis Agent + Strategy Agent ---
# OpenAI-compatible endpoint: https://api.x.ai/v1/chat/completions
GROK_API_KEY=your_grok_api_key_here
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4-fast
GROK_TIMEOUT_MS=8000

# --- Razorpay Test Mode ---
# Get these from https://dashboard.razorpay.com/app/keys (toggle to Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
